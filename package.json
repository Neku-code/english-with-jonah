{
  "name": "english-with-jonah",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0",
  "imports": {
    "#lib/server/db": "./src/lib/server/db/index.ts",
    "#lib/server/*": "./src/lib/server/*.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "students": "tsx scripts/students.ts",
    "unit1:publish": "tsx scripts/publish-unit1.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/check-db.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/functions": "3.10.1",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "7.0.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
