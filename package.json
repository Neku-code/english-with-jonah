{
  "name": "english-with-jonah",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/check-db.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "7.0.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
