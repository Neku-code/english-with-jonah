# Server only. Neon deploy pulls .env.local (or .env if it already exists).
# For manual setup, copy this file to .env.local; add values separately in Vercel.
# Use the Neon pooled URL for runtime queries. Never prefix with PUBLIC_ or VITE_.
DATABASE_URL=
# Optional direct connection for migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Include sslmode=require (or verify-full) in the Neon URL.
# Teacher entry: set privately to the exact, case-sensitive Box 6 value supplied
# by the owner. No trimming or normalization. Never use PUBLIC_ or VITE_.
TEACHER_ENTRY_NAME=
# Student sessions last 30 days; teacher sessions last 12 hours.
